#!/usr/bin/env python3
"""CLI di tollgate. Solo libreria standard (spec 3)."""
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.stderr.write("tollgate richiede Python >= 3.11\n")
    sys.exit(2)
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

if sys.argv[1:2] == ["gate"]:
    # il gate gira su GitHub senza DB né stato: non carica tollgate_core.cli (decisione 1)
    from tollgate_gate.cli import main  # noqa: E402
    sys.exit(main(sys.argv[2:]))
from tollgate_core.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
